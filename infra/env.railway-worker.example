# ─────────────────────────────────────────────────────────────────────────────
# Variables del servicio "worker" en Railway (producción).
# Pegar en Railway → servicio worker → Variables → "Raw Editor". PLANTILLA: sin secretos reales.
# El worker NO expone puerto ni dominio público y debe tener UNA sola réplica.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
TZ=America/La_Paz

DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# Mismos valores que en la API
SMTP_URL=smtps://USUARIO:CLAVE@smtp.proveedor.com:465
MAIL_FROM="Rodalaser ERP <no-reply@TU-DOMINIO>"

# Eventos del outbox por ciclo
OUTBOX_BATCH=50

# Pendiente: cuando siat.processor descifre credenciales SIAT, el worker necesitará la misma clave
# que la API (hoy su esquema de variables no la incluye; ver docs/deployment.md §2.8).
# SECRETS_KEY=
