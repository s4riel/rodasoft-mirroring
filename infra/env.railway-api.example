# ─────────────────────────────────────────────────────────────────────────────
# Variables del servicio "api" en Railway (producción).
# Cómo usarlo: Railway → servicio api → Variables → "Raw Editor" → pegar este contenido
# con los valores reales. Este archivo es una PLANTILLA: no pongas secretos reales aquí.
#
# Las referencias ${{Servicio.VARIABLE}} las resuelve Railway; así no copias contraseñas.
# [VERIFICAR] que los nombres "Postgres" y "Redis" coinciden con los de tu proyecto.
#
# Mientras no haya dominio (staging con URL gratuitas):
#   API_PUBLIC_URL=https://<tu-api>.up.railway.app
#   CORS_ORIGINS=https://<tu-erp>.vercel.app
#   ERP_PUBLIC_URL=https://<tu-erp>.vercel.app
#   GOOGLE_CALLBACK_URL=https://<tu-api>.up.railway.app/api/v1/auth/google/callback
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──
NODE_ENV=production
TZ=America/La_Paz

# ── Puerto ──
# Hasta que el código lea PORT (ver docs/deployment.md §2.1), fijar ambos al mismo valor.
PORT=3000
API_PORT=3000

# ── URLs públicas (cambiar TU-DOMINIO por el dominio real) ──
API_PUBLIC_URL=https://api.TU-DOMINIO
CORS_ORIGINS=https://rodalaser.erp.TU-DOMINIO,https://company2.erp.TU-DOMINIO
ERP_PUBLIC_URL=https://{company}.erp.TU-DOMINIO

# ── Base de datos y colas (referencias a los servicios de Railway, red privada) ──
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# ── Autenticación ──
# Generar localmente (no en un sitio web):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Sin COOKIE_DOMAIN: la cookie queda en el host de cada ERP (una sesión por empresa).
COOKIE_SECURE=true

# ── Google OAuth (Google Cloud Console → Credenciales → ID de cliente OAuth "Aplicación web") ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.TU-DOMINIO/api/v1/auth/google/callback
# Dominio de Google Workspace si solo se permite ese (vacío = cualquier cuenta invitada)
GOOGLE_ALLOWED_HD=

# ── Cifrado de secretos en la base de datos (credenciales SIAT, .p12) ──
# 32 bytes en base64. Generar localmente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GUÁRDALA FUERA DE RAILWAY (gestor de contraseñas). Si se pierde, no se pueden descifrar
# las credenciales SIAT guardadas. No la cambies después de guardar credenciales.
SECRETS_KEY=

# ── Correo ──
# [VERIFICAR] que tu plan de Railway permite SMTP saliente; si no, usar un proveedor por API HTTP.
SMTP_URL=smtps://USUARIO:CLAVE@smtp.proveedor.com:465
MAIL_FROM="Rodalaser ERP <no-reply@TU-DOMINIO>"

# ── SIAT (solo para el spike: tools/siat-spike) ───────────
SIAT_AMBIENTE=2
SIAT_BASE_URL=https://pilotosiatservicios.impuestos.gob.bo/v2
SIAT_TOKEN=
SIAT_NIT=
SIAT_CODIGO_SISTEMA=
SIAT_CODIGO_SUCURSAL=0
SIAT_CODIGO_PUNTO_VENTA=0
SIAT_MODALIDAD=1
SIAT_P12_PATH=./secrets/firma.p12
SIAT_P12_PASSWORD=

# Uploads: "local" saves to STORAGE_LOCAL_DIR (development); "cloudinary" uploads to Cloudinary (production)
STORAGE_DRIVER=cloudinary
STORAGE_LOCAL_DIR=./storage-local
CLOUDINARY_CLOUD_NAME=aqnclo25
CLOUDINARY_API_KEY=246938339823691
CLOUDINARY_API_SECRET=zIs0YjG7Hk0NUAjuSiMX1YtVja4
CLOUDINARY_FOLDER=rodasoft
