# Caddy: TLS automático (Let's Encrypt), compresión y enrutamiento.
# Variables (infra/.env.prod): DOMAIN (p. ej. rodalaser.com.bo), DOMAIN_EMPRESA2, ACME_EMAIL
{
	email {$ACME_EMAIL}
}

(seguridad) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# API pública (login con Google, webhooks de pagos)
api.{$DOMAIN} {
	import seguridad
	reverse_proxy api:3000
}

# ERP: una URL por empresa. El Host se conserva → la API sabe qué empresa es.
rodalaser.erp.{$DOMAIN}, empresa2.erp.{$DOMAIN} {
	import seguridad
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/erp
		@assets path *.js *.css *.woff2 *.svg *.png *.webp
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# Sitio web + tienda (las dos marcas, mismo servidor SSR)
{$DOMAIN}, www.{$DOMAIN}, {$DOMAIN_EMPRESA2} {
	import seguridad
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:4000
	}
}
