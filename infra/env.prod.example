# ── Dominios y TLS ──
DOMAIN=rodalaser.com.bo
DOMAIN_COMPANY2=company2.com.bo
ACME_EMAIL=soporte@rodalaser.com.bo

# ── PostgreSQL ──
POSTGRES_USER=rodasoft
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=rodasoft
DATABASE_URL=postgresql://rodasoft:cambia-esto@postgres:5432/rodasoft?schema=public
REDIS_URL=redis://redis:6379

# ── API ──
NODE_ENV=production
API_PORT=3000
API_PUBLIC_URL=https://api.rodalaser.com.bo
CORS_ORIGINS=https://rodalaser.erp.rodalaser.com.bo,https://company2.erp.rodalaser.com.bo
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=true
SECRETS_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.rodalaser.com.bo/api/v1/auth/google/callback
GOOGLE_ALLOWED_HD=
ERP_PUBLIC_URL=https://{company}.erp.rodalaser.com.bo
SMTP_URL=smtps://usuario:clave@smtp.proveedor.com:465
MAIL_FROM="Rodalaser ERP <no-reply@rodalaser.com.bo>"
