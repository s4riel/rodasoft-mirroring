    { "match": "^BOLAS EN", "category": "Accesorios", "subcategory": null, "icon": "package" },
    { "match": "^JUEGO ROD|^ROD\\. ESFERICO RETEN", "category": "Rodamientos", "subcategory": "Kits y juegos", "icon": "bearing" },
    { "match": "HUB|MACEROS", "category": "Rodamientos", "subcategory": "Ruedas y cubos", "icon": "bearing" },
    { "match": "DE RUEDAS|RUEDAS", "category": "Rodamientos", "subcategory": "Ruedas y cubos", "icon": "bearing" },
