    { "match": "POLEA|TENSOR", "category": "Rodamientos", "subcategory": "Poleas y tensores", "icon": "bearing" },
    { "match": "(^|[^A-Z])DIRECCION([^A-Z]|$)", "category": "Rodamientos", "subcategory": "Dirección", "icon": "bearing" },
