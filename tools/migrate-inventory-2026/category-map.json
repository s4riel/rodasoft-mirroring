    { "match": "AGUJA|CANASTILLO", "category": "Rodamientos", "subcategory": "Agujas", "icon": "bearing" },
    { "match": "ROD(ILLO)?\\.? CONICO", "category": "Rodamientos", "subcategory": "Rodillos cónicos", "icon": "bearing" },
