    { "match": "APOYO", "category": "Rodamientos", "subcategory": "Axiales de bolas", "icon": "bearing" },
    { "match": "RIGIDOS", "category": "Rodamientos", "subcategory": "Rígidos de bolas", "icon": "bearing" },
    { "match": ".*", "category": "Rodamientos", "subcategory": "Especiales", "icon": "bearing" }
  ]
