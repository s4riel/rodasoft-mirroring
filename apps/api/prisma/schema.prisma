// ─────────────────────────────────────────────────────────────────────────────
// Rodasoft — base schema (S0): multi-company, access, permissions, audit and outbox.
// Conventions (see docs/naming-conventions.md):
//  - Everything in English. Tables are plural snake_case (@@map), columns snake_case (@map),
//    models singular PascalCase, fields camelCase.
//  - Every business table has company_id (multi-tenant in a shared schema).
//  - Money: Decimal(14,2); costs and exchange rates: Decimal(14,4). Never Float.
//  - IDs: UUID v7 generated by Prisma (time-ordered, index friendly).
// Modules (inventory, sales, invoicing…) are added sprint by sprint.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent, citext]
}

enum BrandMode {
  rodalaser
  company2
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum SiatEnvironment {
  PRODUCTION // 1
  TEST // 2
}

enum SiatModality {
  ELECTRONIC_ONLINE // 1
  COMPUTERIZED_ONLINE // 2
}

// ── Multi-company ───────────────────────────────────────────────────────────

model Company {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique // defines the URL: <slug>.erp.<domain>
  legalName String       @map("legal_name")
  tradeName String       @map("trade_name")
  nit       String       @unique
  brand     BrandMode    @default(rodalaser)
  status    RecordStatus @default(ACTIVE)
  currency  String       @default("BOB") @db.Char(3)
  timezone  String       @default("America/La_Paz")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches      Branch[]
  warehouses    Warehouse[]
  memberships   Membership[]
  roles         Role[]
  siatSettings  SiatSettings?
  pointsOfSale  SiatPointOfSale[]
  auditLogs     AuditLog[]
  outboxEvents  OutboxEvent[]

  @@map("companies")
}

model Branch {
  id        String       @id @default(uuid(7)) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  code      Int // SIN branch code (0 = head office)
  name      String
  address   String?
  city      String       @default("Cochabamba")
  phone     String?
  latitude  Decimal?     @db.Decimal(9, 6)
  longitude Decimal?     @db.Decimal(9, 6)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company              @relation(fields: [companyId], references: [id])
  warehouses   Warehouse[]
  pointsOfSale SiatPointOfSale[]
  memberships  MembershipBranch[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

/// Each branch has more than one warehouse (client decision).
model Warehouse {
  id        String       @id @default(uuid(7)) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  branchId  String       @map("branch_id") @db.Uuid
  code      String // e.g. HK-01
  name      String
  isMain    Boolean      @default(false) @map("is_main")
  /// the online store only sells from published warehouses
  visibleInStore Boolean @default(true) @map("visible_in_store")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, branchId])
  @@map("warehouses")
}

// ── Users, access and permissions ───────────────────────────────────────────

/// Global user: one person can have a membership in both companies.
model User {
  id           String       @id @default(uuid(7)) @db.Uuid
  email        String       @unique @db.Citext
  name         String
  passwordHash String?      @map("password_hash") // null = Google only or pending invitation
  googleSub    String?      @unique @map("google_sub")
  avatarUrl    String?      @map("avatar_url")
  status       RecordStatus @default(ACTIVE)
  lastLoginAt  DateTime?    @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships    Membership[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  @@map("users")
}

/// A user's belonging to a company, with one role and the branches they may operate.
model Membership {
  id        String       @id @default(uuid(7)) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  roleId    String       @map("role_id") @db.Uuid
  /// true = may operate every branch (ContextBar Branch=All)
  allBranches Boolean    @default(false) @map("all_branches")
  status    RecordStatus @default(ACTIVE)
  invitedBy String?      @map("invited_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company            @relation(fields: [companyId], references: [id])
  user     User               @relation(fields: [userId], references: [id])
  role     Role               @relation(fields: [roleId], references: [id])
  branches MembershipBranch[]

  @@unique([companyId, userId])
  @@index([userId])
  @@map("memberships")
}

model MembershipBranch {
  membershipId String @map("membership_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@id([membershipId, branchId])
  @@map("membership_branches")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  key         String // admin, management, cashier, warehouse, accountant…
  name        String // Spanish display name
  description String?
  isSystem    Boolean  @default(false) @map("is_system") // system roles cannot be deleted
  /// discount limit without approval (%), used by the VP-13 rule
  maxDiscount Decimal  @default(0) @map("max_discount") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  memberships Membership[]

  @@unique([companyId, key])
  @@map("roles")
}

/// Global permission catalog; the source of truth is libs/domain/src/lib/permissions.ts.
model Permission {
  key         String @id
  description String // Spanish label shown in the Roles screen
  module      String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// Rotating refresh tokens: every use creates a new one in the same family.
/// Reusing an already-rotated token revokes the whole family (possible theft).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") // sha256 of the token
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ── SIAT invoicing: per-company settings (details in S2/S3) ─────────────────

model SiatSettings {
  companyId                  String          @id @map("company_id") @db.Uuid
  environment                SiatEnvironment @default(TEST)
  modality                   SiatModality    @default(ELECTRONIC_ONLINE)
  systemCode                 String?         @map("system_code")
  /// SIAT delegated token, encrypted with AES-256-GCM (SecretsService)
  tokenEncrypted             String?         @map("token_encrypted")
  tokenExpiresAt             DateTime?       @map("token_expires_at") @db.Timestamptz(3)
  /// encrypted .p12 digital signature (base64) and its encrypted password
  signatureP12Encrypted      String?         @map("signature_p12_encrypted")
  signaturePasswordEncrypted String?         @map("signature_password_encrypted")
  signatureExpiresAt         DateTime?       @map("signature_expires_at") @db.Timestamptz(3)
  signatureHolder            String?         @map("signature_holder")
  updatedAt                  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])

  @@map("siat_settings")
}

model SiatPointOfSale {
  id              String    @id @default(uuid(7)) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  code            Int // SIN point-of-sale code
  name            String
  cuis            String?
  cuisExpiresAt   DateTime? @map("cuis_expires_at") @db.Timestamptz(3)
  cufd            String?
  cufdControlCode String?   @map("cufd_control_code")
  cufdAddress     String?   @map("cufd_address")
  cufdExpiresAt   DateTime? @map("cufd_expires_at") @db.Timestamptz(3)
  lastSyncedAt    DateTime? @map("last_synced_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([companyId, branchId, code])
  @@map("siat_points_of_sale")
}

// ── Cross-cutting ───────────────────────────────────────────────────────────

/// Audit log: who did what, on which entity, before and after.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  companyId String?  @map("company_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String // auth.login, sales.cancellation.approve…
  entity    String?
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// Transactional outbox: domain events are written in the SAME transaction as the
/// business change; the worker publishes them (accounting entries, SIAT, e-mails).
model OutboxEvent {
  id             BigInt    @id @default(autoincrement())
  companyId      String?   @map("company_id") @db.Uuid
  type           String // sale.confirmed, invoice.issue, auth.password-reset…
  payload        Json
  /// key to deduplicate consumers (e.g. invoice:<id>:issue)
  idempotencyKey String?   @unique @map("idempotency_key")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id])

  @@index([processedAt, availableAt])
  @@map("outbox_events")
}
