// ─────────────────────────────────────────────────────────────────────────────
// Rodasoft — base schema (S0): multi-company, access, permissions, audit and outbox.
// Conventions (see docs/naming-conventions.md):
//  - Everything in English. Tables are plural snake_case (@@map), columns snake_case (@map),
//    models singular PascalCase, fields camelCase.
//  - Every business table has company_id (multi-tenant in a shared schema).
//  - Money: Decimal(14,2); costs and exchange rates: Decimal(14,4). Never Float.
//  - IDs: UUID v7 generated by Prisma (time-ordered, index friendly).
// Modules (inventory, sales, invoicing…) are added sprint by sprint.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent, citext]
}

enum BrandMode {
  rodalaser
  company2
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

/// Products also have DRAFT (HU-INV-06): an unfinished product saved from the creation wizard. Drafts stay out of the
/// lists and the filter options unless asked for.
enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum SiatEnvironment {
  PRODUCTION // 1
  TEST // 2
}

enum SiatModality {
  ELECTRONIC_ONLINE // 1
  COMPUTERIZED_ONLINE // 2
}

// ── Multi-company ───────────────────────────────────────────────────────────

model Company {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique // defines the URL: <slug>.erp.<domain>
  legalName String       @map("legal_name")
  tradeName String       @map("trade_name")
  nit       String       @unique
  brand     BrandMode    @default(rodalaser)
  status    RecordStatus @default(ACTIVE)
  currency  String       @default("BOB") @db.Char(3)
  timezone  String       @default("America/La_Paz")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches             Branch[]
  warehouses           Warehouse[]
  memberships          Membership[]
  roles                Role[]
  siatSettings         SiatSettings?
  pointsOfSale         SiatPointOfSale[]
  auditLogs            AuditLog[]
  outboxEvents         OutboxEvent[]
  countries            Country[]
  brands               Brand[]
  categories           Category[]
  attributeDefinitions AttributeDefinition[]
  products             Product[]
  productDimensions    ProductDimension[]
  stockLevels          StockLevel[]
  stockThresholds      StockThreshold[]
  stockMovements       StockMovement[]
  equivalences         Equivalence[]
  transfers            Transfer[]
  transferItems        TransferItem[]
  transferReceipts     TransferReceipt[]
  transferReceiptItems TransferReceiptItem[]
  stockAdjustments     StockAdjustment[]
  stockAdjustmentItems StockAdjustmentItem[]
  companySettings      CompanySetting[]
  customers            Customer[]
  cashRegisters        CashRegister[]
  cashShifts           CashShift[]
  cashMovements        CashMovement[]
  cashCounts           CashCount[]
  posCheckouts         PosCheckout[]
  posCheckoutItems     PosCheckoutItem[]
  posCheckoutPayments  PosCheckoutPayment[]
  sales                Sale[]
  saleItems            SaleItem[]
  salePayments         SalePayment[]
  invoices             Invoice[]
  quotes               Quote[]
  quoteItems           QuoteItem[]
  salesOrders          SalesOrder[]
  salesOrderItems      SalesOrderItem[]
  dispatches           Dispatch[]
  dispatchItems        DispatchItem[]
  saleReturns          SaleReturn[]
  saleReturnItems      SaleReturnItem[]
  priceChanges         PriceChange[]
  approvalRequests     ApprovalRequest[]
  documentSequences    DocumentSequence[]

  @@map("companies")
}

model Branch {
  id        String       @id @default(uuid(7)) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  code      Int // SIN branch code (0 = head office)
  name      String
  address   String?
  city      String       @default("Cochabamba")
  phone     String?
  latitude  Decimal?     @db.Decimal(9, 6)
  longitude Decimal?     @db.Decimal(9, 6)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company            @relation(fields: [companyId], references: [id])
  warehouses    Warehouse[]
  pointsOfSale  SiatPointOfSale[]
  memberships   MembershipBranch[]
  cashRegisters CashRegister[]
  sales         Sale[]
  salesOrders   SalesOrder[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

/// Each branch has more than one warehouse (client decision).
model Warehouse {
  id             String       @id @default(uuid(7)) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  code           String // e.g. HK-01
  name           String
  isMain         Boolean      @default(false) @map("is_main")
  /// the online store only sells from published warehouses
  visibleInStore Boolean      @default(true) @map("visible_in_store")
  /// address or physical reference of the warehouse (IN-30)
  locationNote   String?      @map("location_note")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company          Company           @relation(fields: [companyId], references: [id])
  branch           Branch            @relation(fields: [branchId], references: [id])
  stockLevels      StockLevel[]
  stockThresholds  StockThreshold[]
  stockMovements   StockMovement[]
  transfersOut     Transfer[]        @relation("TransferOrigin")
  transfersIn      Transfer[]        @relation("TransferDestination")
  stockAdjustments StockAdjustment[]
  cashRegisters    CashRegister[]
  sales            Sale[]
  salesOrders      SalesOrder[]

  @@unique([companyId, code])
  @@index([companyId, branchId])
  @@map("warehouses")
}

// ── Users, access and permissions ───────────────────────────────────────────

/// Global user: one person can have a membership in both companies.
model User {
  id           String       @id @default(uuid(7)) @db.Uuid
  email        String       @unique @db.Citext
  name         String
  passwordHash String?      @map("password_hash") // null = Google only or pending invitation
  googleSub    String?      @unique @map("google_sub")
  avatarUrl    String?      @map("avatar_url")
  status       RecordStatus @default(ACTIVE)
  lastLoginAt  DateTime?    @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships              Membership[]
  createdProducts          Product[]         @relation("ProductCreatedBy")
  createdEquivalences      Equivalence[]     @relation("EquivalenceCreatedBy")
  approvedEquivalences     Equivalence[]     @relation("EquivalenceApprovedBy")
  updatedProducts          Product[]         @relation("ProductUpdatedBy")
  deactivatedProducts      Product[]         @relation("ProductDeactivatedBy")
  refreshTokens            RefreshToken[]
  passwordResets           PasswordReset[]
  stockMovements           StockMovement[]
  createdTransfers         Transfer[]        @relation("TransferCreatedBy")
  sentTransfers            Transfer[]        @relation("TransferSentBy")
  approvedTransfers        Transfer[]        @relation("TransferApprovedBy")
  receivedTransfers        Transfer[]        @relation("TransferReceivedBy")
  transferReceipts         TransferReceipt[]
  createdStockAdjustments  StockAdjustment[] @relation("StockAdjustmentCreatedBy")
  approvedStockAdjustments StockAdjustment[] @relation("StockAdjustmentApprovedBy")
  companySettingsUpdated   CompanySetting[]

  @@map("users")
}

/// A user's belonging to a company, with one role and the branches they may operate.
model Membership {
  id          String       @id @default(uuid(7)) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  roleId      String       @map("role_id") @db.Uuid
  /// true = may operate every branch (ContextBar Branch=All)
  allBranches Boolean      @default(false) @map("all_branches")
  status      RecordStatus @default(ACTIVE)
  invitedBy   String?      @map("invited_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company            @relation(fields: [companyId], references: [id])
  user     User               @relation(fields: [userId], references: [id])
  role     Role               @relation(fields: [roleId], references: [id])
  branches MembershipBranch[]

  @@unique([companyId, userId])
  @@index([userId])
  @@map("memberships")
}

model MembershipBranch {
  membershipId String @map("membership_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@id([membershipId, branchId])
  @@map("membership_branches")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  key         String // admin, management, cashier, warehouse, accountant…
  name        String // Spanish display name
  description String?
  isSystem    Boolean  @default(false) @map("is_system") // system roles cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  memberships Membership[]

  @@unique([companyId, key])
  @@map("roles")
}

/// Global permission catalog; the source of truth is libs/domain/src/lib/permissions.ts.
model Permission {
  key         String @id
  description String // Spanish label shown in the Roles screen
  module      String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// Rotating refresh tokens: every use creates a new one in the same family.
/// Reusing an already-rotated token revokes the whole family (possible theft).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") // sha256 of the token
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ── SIAT invoicing: per-company settings (details in S2/S3) ─────────────────

model SiatSettings {
  companyId                  String          @id @map("company_id") @db.Uuid
  environment                SiatEnvironment @default(TEST)
  modality                   SiatModality    @default(ELECTRONIC_ONLINE)
  systemCode                 String?         @map("system_code")
  /// SIAT delegated token, encrypted with AES-256-GCM (SecretsService)
  tokenEncrypted             String?         @map("token_encrypted")
  tokenExpiresAt             DateTime?       @map("token_expires_at") @db.Timestamptz(3)
  /// encrypted .p12 digital signature (base64) and its encrypted password
  signatureP12Encrypted      String?         @map("signature_p12_encrypted")
  signaturePasswordEncrypted String?         @map("signature_password_encrypted")
  signatureExpiresAt         DateTime?       @map("signature_expires_at") @db.Timestamptz(3)
  signatureHolder            String?         @map("signature_holder")
  updatedAt                  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])

  @@map("siat_settings")
}

model SiatPointOfSale {
  id              String    @id @default(uuid(7)) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  code            Int // SIN point-of-sale code
  name            String
  cuis            String?
  cuisExpiresAt   DateTime? @map("cuis_expires_at") @db.Timestamptz(3)
  cufd            String?
  cufdControlCode String?   @map("cufd_control_code")
  cufdAddress     String?   @map("cufd_address")
  cufdExpiresAt   DateTime? @map("cufd_expires_at") @db.Timestamptz(3)
  lastSyncedAt    DateTime? @map("last_synced_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id])
  cashRegister CashRegister?

  @@unique([companyId, branchId, code])
  @@map("siat_points_of_sale")
}

// ── Inventory: product catalog (HU-INV-01, block A foundations) ─────────────

enum AttributeType {
  TEXT
  NUMBER
  ENUM
  BOOLEAN
}

/// "Industry" in the UI: the country of origin, shown with its flag.
model Country {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String   @db.Char(2) // ISO 3166-1 alpha-2, e.g. SE
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id])
  brands   Brand[]
  products Product[]

  @@unique([companyId, code])
  @@map("countries")
}

model Brand {
  id        String       @id @default(uuid(7)) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  countryId String?      @map("country_id") @db.Uuid
  name      String
  /// optional (decision #38): without a logo the UI shows the name
  logoUrl   String?      @map("logo_url")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id])
  country  Country?  @relation(fields: [countryId], references: [id])
  products Product[]

  @@unique([companyId, name])
  @@index([companyId, countryId])
  @@map("brands")
}

/// Two levels: a root category (parentId null) and its subcategories.
model Category {
  id        String       @id @default(uuid(7)) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  parentId  String?      @map("parent_id") @db.Uuid
  name      String
  icon      String       @default("box")
  sortOrder Int          @default(0) @map("sort_order")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company              Company               @relation(fields: [companyId], references: [id])
  parent               Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children             Category[]            @relation("CategoryTree")
  attributeDefinitions AttributeDefinition[]
  products             Product[]

  @@unique([companyId, parentId, name])
  @@index([companyId, parentId])
  @@map("categories")
}

model AttributeDefinition {
  id         String        @id @default(uuid(7)) @db.Uuid
  companyId  String        @map("company_id") @db.Uuid
  categoryId String        @map("category_id") @db.Uuid
  key        String
  label      String
  type       AttributeType
  unit       String?
  options    Json?
  required   Boolean       @default(false)
  /// creation step the field belongs to (2 = Dimensions, 3 = Technical specifications), see design-notes
  step       Int           @default(0)
  /// order inside the step
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, key])
  @@index([companyId])
  @@map("attribute_definitions")
}

model Product {
  id               String        @id @default(uuid(7)) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  sku              String // sequential internal SKU per company (RL-000001), decision #32
  manufacturerCode String        @map("manufacturer_code")
  brandId          String        @map("brand_id") @db.Uuid
  /// leaf category (a subcategory when the product has one)
  categoryId       String        @map("category_id") @db.Uuid
  /// industry (country of origin) of the product; falls back to the brand's country when null
  countryId        String?       @map("country_id") @db.Uuid
  name             String
  salePrice        Decimal       @map("sale_price") @db.Decimal(14, 2)
  /// only visible with inventory.costs.view
  cost             Decimal?      @db.Decimal(14, 4)
  unit             String        @default("UN")
  status           ProductStatus @default(ACTIVE)
  /// sectors the product is used in (chips in the wizard, HU-INV-06)
  sectors          String[]      @default([])
  tariffCode       String?       @map("tariff_code")
  supplierName     String?       @map("supplier_name")
  entryDate        DateTime?     @map("entry_date") @db.Date
  attributes       Json          @default("{}")
  photos           Json          @default("[]")
  datasheetUrl     String?       @map("datasheet_url")
  createdById      String?       @map("created_by_id") @db.Uuid
  updatedById      String?       @map("updated_by_id") @db.Uuid
  /// set while the product is INACTIVE (HU-INV-09); cleared on reactivation
  deactivatedAt    DateTime?     @map("deactivated_at") @db.Timestamptz(3)
  deactivatedById  String?       @map("deactivated_by_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company              Company               @relation(fields: [companyId], references: [id])
  brand                Brand                 @relation(fields: [brandId], references: [id])
  category             Category              @relation(fields: [categoryId], references: [id])
  country              Country?              @relation(fields: [countryId], references: [id], onDelete: SetNull)
  dimensions           ProductDimension?
  stockLevels          StockLevel[]
  stockThresholds      StockThreshold[]
  stockMovements       StockMovement[]
  equivalencesAsA      Equivalence[]         @relation("EquivalenceProductA")
  equivalencesAsB      Equivalence[]         @relation("EquivalenceProductB")
  transferItems        TransferItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  posCheckoutItems     PosCheckoutItem[]
  saleItems            SaleItem[]
  quoteItems           QuoteItem[]
  salesOrderItems      SalesOrderItem[]
  priceChanges         PriceChange[]
  createdBy            User?                 @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?                 @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deactivatedBy        User?                 @relation("ProductDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: Restrict)

  @@unique([companyId, sku])
  @@unique([companyId, brandId, manufacturerCode])
  @@index([companyId, status])
  @@index([companyId, brandId])
  @@index([companyId, categoryId])
  @@index([companyId, countryId])
  @@index([companyId, createdAt(sort: Desc), id])
  @@map("products")
}

/// Measurements in mm / kg; indexed for the equivalence search (HU-INV-11).
model ProductDimension {
  productId     String   @id @map("product_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  innerDiameter Decimal? @map("inner_diameter") @db.Decimal(10, 3) // d
  outerDiameter Decimal? @map("outer_diameter") @db.Decimal(10, 3) // D
  width         Decimal? @db.Decimal(10, 3) // B (T for tapered bearings)
  weight        Decimal? @db.Decimal(10, 3)

  company Company @relation(fields: [companyId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, innerDiameter, outerDiameter, width])
  @@map("product_dimensions")
}

/// Current stock per warehouse. Only the movements service writes it (HU-INV-16);
/// this story only reads it.
model StockLevel {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([companyId, warehouseId])
  @@map("stock_levels")
}

/// Minimum / maximum stock and shelf location of a product in a warehouse (HU-INV-05). Per warehouse, not per branch:
/// IN-23 shows one row per warehouse, and the branch figures are the sum over its warehouses.
model StockThreshold {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  minStock    Int?     @map("min_stock")
  maxStock    Int?     @map("max_stock")
  location    String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id])
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([companyId, warehouseId])
  @@map("stock_thresholds")
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  INITIAL
  RETURN
}

/// Immutable history of stock changes (design-notes rule 3): a database trigger rejects UPDATE and DELETE, so a
/// correction is a new movement. Only the movements service writes it (HU-INV-16); HU-INV-05 only reads it.
model StockMovement {
  id           String            @id @default(uuid(7)) @db.Uuid
  companyId    String            @map("company_id") @db.Uuid
  productId    String            @map("product_id") @db.Uuid
  warehouseId  String            @map("warehouse_id") @db.Uuid
  type         StockMovementType
  /// signed: positive adds stock, negative removes it
  quantity     Int
  /// warehouse balance after this movement, so the kardex never needs a re-sum
  balanceAfter Int               @map("balance_after")
  unitCost     Decimal?          @map("unit_cost") @db.Decimal(14, 4)
  reason       String?
  /// source document (refType "SALE", "TRANSFER", "ADJUSTMENT", "PURCHASE") and its number for display ("V-00231")
  refType      String?           @map("ref_type")
  refId        String?           @map("ref_id") @db.Uuid
  refNumber    String?           @map("ref_number")
  userId       String?           @map("user_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user      User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([companyId, productId, createdAt(sort: Desc)])
  @@index([companyId, warehouseId, productId, createdAt])
  @@map("stock_movements")
}

/// Direct equivalence link between two products (HU-INV-04). The pair is stored once, with `productAId < productBId`
/// (CHECK in the migration), which also forbids self-links and a duplicate in reverse order. Whether the link is
/// exact or has differences is computed on read from the products, so it is not stored.
model Equivalence {
  id           String    @id @default(uuid(7)) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  productAId   String    @map("product_a_id") @db.Uuid
  productBId   String    @map("product_b_id") @db.Uuid
  createdById  String?   @map("created_by_id") @db.Uuid
  /// decision #34: approval is optional (setting `inventory.equivalences.requireApproval`); without it a link is saved approved
  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(3)
  /// true when the user classified the link as a substitute: it replaces the product but is not a technical equivalent (IN-15c)
  substitute   Boolean   @default(false)
  /// observed differences, free text shown to the seller before offering the equivalent (IN-15c)
  notes        String?   @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company    Company @relation(fields: [companyId], references: [id])
  productA   Product @relation("EquivalenceProductA", fields: [productAId], references: [id], onDelete: Cascade)
  productB   Product @relation("EquivalenceProductB", fields: [productBId], references: [id], onDelete: Cascade)
  createdBy  User?   @relation("EquivalenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?   @relation("EquivalenceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([companyId, productAId, productBId])
  @@index([companyId, productBId])
  @@map("equivalences")
}

/// Mirrors the `TransferStatus` union of `libs/domain` (state-machine.ts); status changes go through `transferMachine`.
enum TransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  REJECTED
  CANCELLED
}

/// Transfer of merchandise between two warehouses (HU-INV-18). Stock leaves the origin on send; "in transit" is not
/// stored: it is the sum of `quantity - received_quantity` of the items while the transfer is IN_TRANSIT or
/// PARTIALLY_RECEIVED. Totals and costs are frozen when the transfer is sent.
model Transfer {
  id                     String         @id @default(uuid(7)) @db.Uuid
  companyId              String         @map("company_id") @db.Uuid
  /// `TR-000123`, shared series per company
  number                 String
  status                 TransferStatus @default(DRAFT)
  originWarehouseId      String         @map("origin_warehouse_id") @db.Uuid
  destinationWarehouseId String         @map("destination_warehouse_id") @db.Uuid
  note                   String?        @db.VarChar(500)
  totalPieces            Int            @default(0) @map("total_pieces")
  /// at average cost, frozen on send
  totalValue             Decimal        @default(0) @map("total_value") @db.Decimal(14, 2)
  createdById            String?        @map("created_by_id") @db.Uuid
  sentById               String?        @map("sent_by_id") @db.Uuid
  sentAt                 DateTime?      @map("sent_at") @db.Timestamptz(3)
  approvedById           String?        @map("approved_by_id") @db.Uuid
  approvedAt             DateTime?      @map("approved_at") @db.Timestamptz(3)
  /// who closed the receipt and when (HU-INV-21)
  receivedById           String?        @map("received_by_id") @db.Uuid
  receivedAt             DateTime?      @map("received_at") @db.Timestamptz(3)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company              Company           @relation(fields: [companyId], references: [id])
  originWarehouse      Warehouse         @relation("TransferOrigin", fields: [originWarehouseId], references: [id])
  destinationWarehouse Warehouse         @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])
  createdBy            User?             @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sentBy               User?             @relation("TransferSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  approvedBy           User?             @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  receivedBy           User?             @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  items                TransferItem[]
  receipts             TransferReceipt[]
  adjustment           StockAdjustment?

  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@index([companyId, originWarehouseId])
  @@index([companyId, destinationWarehouseId])
  @@map("transfers")
}

model TransferItem {
  id               String   @id @default(uuid(7)) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  transferId       String   @map("transfer_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  quantity         Int
  /// filled by the receipt sessions (HU-INV-21); never above `quantity`
  receivedQuantity Int      @default(0) @map("received_quantity")
  /// pieces that arrived beyond `quantity`, entered when the receipt is closed; not in stock until the adjustment is approved
  surplusQuantity  Int      @default(0) @map("surplus_quantity")
  /// average cost of the product, frozen on send
  unitCost         Decimal? @map("unit_cost") @db.Decimal(14, 4)

  company      Company               @relation(fields: [companyId], references: [id])
  transfer     Transfer              @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product      Product               @relation(fields: [productId], references: [id])
  receiptItems TransferReceiptItem[]

  @@unique([transferId, productId])
  @@index([companyId, productId])
  @@map("transfer_items")
}

/// One receiving session of a transfer (HU-INV-21): the pieces counted at the destination at that moment. Kept as its own
/// document so the history survives and the `TRANSFER_IN` movements can point at it (`ref_type TRANSFER_RECEIPT`).
model TransferReceipt {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  transferId   String   @map("transfer_id") @db.Uuid
  receivedById String?  @map("received_by_id") @db.Uuid
  note         String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company    Company               @relation(fields: [companyId], references: [id])
  transfer   Transfer              @relation(fields: [transferId], references: [id], onDelete: Cascade)
  receivedBy User?                 @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  items      TransferReceiptItem[]

  @@index([companyId, transferId])
  @@map("transfer_receipts")
}

model TransferReceiptItem {
  id             String @id @default(uuid(7)) @db.Uuid
  companyId      String @map("company_id") @db.Uuid
  receiptId      String @map("receipt_id") @db.Uuid
  transferItemId String @map("transfer_item_id") @db.Uuid
  quantity       Int

  company      Company         @relation(fields: [companyId], references: [id])
  receipt      TransferReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  transferItem TransferItem    @relation(fields: [transferItemId], references: [id], onDelete: Cascade)

  @@unique([receiptId, transferItemId])
  @@map("transfer_receipt_items")
}

enum StockAdjustmentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum StockAdjustmentSource {
  MANUAL
  TRANSFER
}

/// SHORTAGE and SURPLUS come from a transfer receipt; IN, OUT and COUNT are the lines of a manual adjustment (HU-INV-22).
/// MANUAL is not used.
enum StockAdjustmentItemKind {
  SHORTAGE
  SURPLUS
  MANUAL
  IN
  OUT
  COUNT
}

/// Stock adjustment document (minimal, created by HU-INV-21 for the differences of a transfer receipt; HU-INV-22/23
/// extend it). Creating one writes no stock: approving a SURPLUS line puts the pieces in, approving a SHORTAGE line only
/// writes the loss off, because those pieces never entered any warehouse. `number` shares the `AJ-` series with the quick
/// adjustments of HU-INV-16 (see `nextAdjustmentNumber`).
model StockAdjustment {
  id           String                @id @default(uuid(7)) @db.Uuid
  companyId    String                @map("company_id") @db.Uuid
  /// `AJ-000123`
  number       String
  status       StockAdjustmentStatus @default(PENDING_APPROVAL)
  source       StockAdjustmentSource
  transferId   String?               @unique @map("transfer_id") @db.Uuid
  warehouseId  String                @map("warehouse_id") @db.Uuid
  /// a manual adjustment stores the reason code (`SHRINKAGE`); a transfer difference stores its own text
  reason       String
  /// free text of a manual adjustment; required when the reason is `OTHER`
  note         String?
  /// sum of the absolute values of the lines
  totalValue   Decimal               @default(0) @map("total_value") @db.Decimal(14, 2)
  createdById  String?               @map("created_by_id") @db.Uuid
  approvedById String?               @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?             @map("approved_at") @db.Timestamptz(3)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company               @relation(fields: [companyId], references: [id])
  transfer   Transfer?             @relation(fields: [transferId], references: [id], onDelete: SetNull)
  warehouse  Warehouse             @relation(fields: [warehouseId], references: [id])
  createdBy  User?                 @relation("StockAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?                 @relation("StockAdjustmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items      StockAdjustmentItem[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id              String                  @id @default(uuid(7)) @db.Uuid
  companyId       String                  @map("company_id") @db.Uuid
  adjustmentId    String                  @map("adjustment_id") @db.Uuid
  productId       String                  @map("product_id") @db.Uuid
  kind            StockAdjustmentItemKind
  /// signed: negative for a shortage, positive for a surplus; for a manual line, the delta applied to the stock
  quantity        Int
  /// what the user typed on a manual line (for COUNT, the counted stock); null on a transfer difference
  enteredQuantity Int?                    @map("entered_quantity")
  unitCost        Decimal?                @map("unit_cost") @db.Decimal(14, 4)

  company    Company         @relation(fields: [companyId], references: [id])
  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])

  @@unique([adjustmentId, productId])
  @@index([companyId, productId])
  @@map("stock_adjustment_items")
}

/// Per-company configuration (HU-INV-06). `key` is typed in `libs/domain` (COMPANY_SETTING_DEFAULTS), so code always
/// has a fallback when no row exists. Open client decisions (#32, #36, #37) are parameterized here.
model CompanySetting {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  key         String
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company @relation(fields: [companyId], references: [id])
  updatedBy User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([companyId, key])
  @@map("company_settings")
}

// ── Sales and POS (HU-VEN-00, docs/sales/design-notes.md) ───────────────────
// Business queries go through `prisma.tenant`. Document states mirror the `libs/domain` unions and change only through
// their machines in state-machine.ts. User references (`*_by_id`, `cashier_id`, `user_id`) are plain uuid columns: the
// audit log records who did what, and users are never deleted.

/// Discount held by the customer record (decision #5): a percent of the sale or a fixed Bs amount per sale.
enum CustomerDiscountType {
  NONE
  PERCENT
  AMOUNT
}

enum CashShiftStatus {
  OPEN
  CLOSED
  APPROVED
  OBSERVED
}

enum CashMovementType {
  INCOME
  EXPENSE
  SALE_PAYMENT
  REFUND
}

enum PosCheckoutStatus {
  OPEN
  PAYING
  COMPLETED
  ON_HOLD
  ABANDONED
}

enum SaleStatus {
  COMPLETED
  CANCELLATION_PENDING
  CANCELLED
}

enum PaymentMethod {
  CASH
  QR
  CARD
  TRANSFER
  CREDIT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

/// Same values as `InvoiceStatus` in libs/domain (`invoiceMachine`); a sale writes it as PENDING.
enum InvoiceStatus {
  PENDING
  SENDING
  VALID
  REJECTED
  CONTINGENCY
  OBSERVED
  CANCELLATION_PENDING
  CANCELLED
}

enum ApprovalType {
  CANCELLATION
  CASH_DIFFERENCE
  RETURN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REJECTED
}

enum SalesOrderStatus {
  OPEN
  PARTIALLY_DISPATCHED
  DISPATCHED
  CANCELLED
}

enum RefundMethod {
  CASH
  CREDIT_NOTE
}

/// Minimal customer (HU-CRM-01 extends it). `documentType` holds the `IdentityDocumentType` code of nit.ts. The discount
/// applies automatically to every sale, quote and order of the customer (HU-VEN-37); the migration adds the CHECKs
/// `discount_value >= 0` and `<= 100` when PERCENT.
model Customer {
  id             String               @id @default(uuid(7)) @db.Uuid
  companyId      String               @map("company_id") @db.Uuid
  name           String
  documentType   Int                  @map("document_type")
  documentNumber String               @map("document_number")
  complement     String?
  email          String?
  phone          String?
  /// decision #53: credit is a yes/no flag, no amount limit
  creditEnabled  Boolean              @default(false) @map("credit_enabled")
  discountType   CustomerDiscountType @default(NONE) @map("discount_type")
  discountValue  Decimal              @default(0) @map("discount_value") @db.Decimal(14, 2)
  status         RecordStatus         @default(ACTIVE)
  createdById    String?              @map("created_by_id") @db.Uuid
  updatedById    String?              @map("updated_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company       @relation(fields: [companyId], references: [id])
  checkouts   PosCheckout[]
  sales       Sale[]
  quotes      Quote[]
  salesOrders SalesOrder[]

  @@unique([companyId, documentType, documentNumber])
  @@index([companyId, name])
  @@map("customers")
}

/// A physical register. One per SIAT point of sale (decision #3); its sales leave stock from `warehouseId`.
model CashRegister {
  id            String       @id @default(uuid(7)) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  branchId      String       @map("branch_id") @db.Uuid
  pointOfSaleId String       @unique @map("point_of_sale_id") @db.Uuid
  warehouseId   String       @map("warehouse_id") @db.Uuid
  name          String
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company         @relation(fields: [companyId], references: [id])
  branch      Branch          @relation(fields: [branchId], references: [id])
  pointOfSale SiatPointOfSale @relation(fields: [pointOfSaleId], references: [id])
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  shifts      CashShift[]

  @@index([companyId, branchId])
  @@map("cash_registers")
}

/// One open→close period of a register. The migration adds a partial unique index: one OPEN shift per register.
model CashShift {
  id               String          @id @default(uuid(7)) @db.Uuid
  companyId        String          @map("company_id") @db.Uuid
  registerId       String          @map("register_id") @db.Uuid
  status           CashShiftStatus @default(OPEN)
  openingFloat     Decimal         @map("opening_float") @db.Decimal(14, 2)
  openedById       String          @map("opened_by_id") @db.Uuid
  openedAt         DateTime        @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedById       String?         @map("closed_by_id") @db.Uuid
  closedAt         DateTime?       @map("closed_at") @db.Timestamptz(3)
  expectedAmount   Decimal?        @map("expected_amount") @db.Decimal(14, 2)
  countedAmount    Decimal?        @map("counted_amount") @db.Decimal(14, 2)
  differenceAmount Decimal?        @map("difference_amount") @db.Decimal(14, 2)
  /// Cash left in the register when the shift closed (filled by HU-VEN-23); the next opening compares its float with it.
  closingFloat     Decimal?        @map("closing_float") @db.Decimal(14, 2)
  reviewedById     String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  reviewNote       String?         @map("review_note")

  company   Company        @relation(fields: [companyId], references: [id])
  register  CashRegister   @relation(fields: [registerId], references: [id])
  movements CashMovement[]
  counts    CashCount[]
  checkouts PosCheckout[]
  sales     Sale[]

  @@index([companyId, registerId, status])
  @@index([companyId, openedAt(sort: Desc)])
  @@map("cash_shifts")
}

/// Manual income/expense with a reason; sale payments also post here (`refType` "SALE", `refId` the sale).
model CashMovement {
  id        String           @id @default(uuid(7)) @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  shiftId   String           @map("shift_id") @db.Uuid
  type      CashMovementType
  amount    Decimal          @db.Decimal(14, 2)
  reason    String?
  refType   String?          @map("ref_type")
  refId     String?          @map("ref_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company   @relation(fields: [companyId], references: [id])
  shift   CashShift @relation(fields: [shiftId], references: [id])

  @@index([companyId, shiftId, createdAt])
  @@map("cash_movements")
}

/// Closing count of a shift by denomination.
model CashCount {
  id           String  @id @default(uuid(7)) @db.Uuid
  companyId    String  @map("company_id") @db.Uuid
  shiftId      String  @map("shift_id") @db.Uuid
  denomination Decimal @db.Decimal(14, 2)
  quantity     Int

  company Company   @relation(fields: [companyId], references: [id])
  shift   CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, denomination])
  @@index([companyId])
  @@map("cash_counts")
}

/// Server-side cart before the sale exists (backs QR payments awaiting confirmation, cart recovery and held sales).
/// Completing it creates the `Sale` in the same transaction.
model PosCheckout {
  id         String            @id @default(uuid(7)) @db.Uuid
  companyId  String            @map("company_id") @db.Uuid
  cashierId  String            @map("cashier_id") @db.Uuid
  shiftId    String            @map("shift_id") @db.Uuid
  customerId String?           @map("customer_id") @db.Uuid
  status     PosCheckoutStatus @default(OPEN)
  holdLabel  String?           @map("hold_label")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company              @relation(fields: [companyId], references: [id])
  shift    CashShift            @relation(fields: [shiftId], references: [id])
  customer Customer?            @relation(fields: [customerId], references: [id])
  items    PosCheckoutItem[]
  payments PosCheckoutPayment[]
  sale     Sale?

  /// partial unique index `pos_checkouts_one_open_per_cashier` on (company_id, cashier_id) WHERE status = 'OPEN', raw SQL in
  /// the migration `pos_checkout_cart` (HU-VEN-02): a cashier has a single sale in progress
  @@index([companyId, cashierId, status])
  @@index([companyId, shiftId])
  @@map("pos_checkouts")
}

model PosCheckoutItem {
  id         String  @id @default(uuid(7)) @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  checkoutId String  @map("checkout_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(14, 2)
  sortOrder  Int     @default(0) @map("sort_order")

  company  Company     @relation(fields: [companyId], references: [id])
  checkout PosCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  product  Product     @relation(fields: [productId], references: [id])

  /// one line per product: adding it again raises the quantity of its line (HU-VEN-02)
  @@unique([checkoutId, productId], map: "pos_checkout_items_checkout_product_key")
  @@index([companyId, checkoutId])
  @@map("pos_checkout_items")
}

/// A payment attempt of a checkout. `idempotencyKey` is unique per company, so a repeated charge or webhook finds the
/// stored row instead of charging twice.
model PosCheckoutPayment {
  id             String        @id @default(uuid(7)) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  checkoutId     String        @map("checkout_id") @db.Uuid
  method         PaymentMethod
  amount         Decimal       @db.Decimal(14, 2)
  idempotencyKey String        @map("idempotency_key")
  providerRef    String?       @map("provider_ref")
  status         PaymentStatus @default(PENDING)
  reference      String?
  /// credit payments only (HU-VEN-34)
  dueDate        DateTime?     @map("due_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company     @relation(fields: [companyId], references: [id])
  checkout PosCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, checkoutId])
  @@map("pos_checkout_payments")
}

/// A paid sale. The customer discount is copied here at sale time, so a later change of the customer does not alter it.
model Sale {
  id             String               @id @default(uuid(7)) @db.Uuid
  companyId      String               @map("company_id") @db.Uuid
  /// `V-000231`, row-locked counter per company (`document_sequences`)
  number         String
  checkoutId     String               @unique @map("checkout_id") @db.Uuid
  customerId     String?              @map("customer_id") @db.Uuid
  branchId       String               @map("branch_id") @db.Uuid
  warehouseId    String               @map("warehouse_id") @db.Uuid
  shiftId        String               @map("shift_id") @db.Uuid
  status         SaleStatus           @default(COMPLETED)
  subtotal       Decimal              @db.Decimal(14, 2)
  discountType   CustomerDiscountType @default(NONE) @map("discount_type")
  discountValue  Decimal              @default(0) @map("discount_value") @db.Decimal(14, 2)
  discountAmount Decimal              @default(0) @map("discount_amount") @db.Decimal(14, 2)
  roundingAmount Decimal              @default(0) @map("rounding_amount") @db.Decimal(14, 2)
  total          Decimal              @db.Decimal(14, 2)
  createdById    String               @map("created_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company       @relation(fields: [companyId], references: [id])
  checkout   PosCheckout   @relation(fields: [checkoutId], references: [id])
  customer   Customer?     @relation(fields: [customerId], references: [id])
  branch     Branch        @relation(fields: [branchId], references: [id])
  warehouse  Warehouse     @relation(fields: [warehouseId], references: [id])
  shift      CashShift     @relation(fields: [shiftId], references: [id])
  items      SaleItem[]
  payments   SalePayment[]
  invoice    Invoice?
  returns    SaleReturn[]
  dispatches Dispatch[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([companyId, shiftId])
  @@index([companyId, customerId])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid(7)) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)
  sortOrder Int     @default(0) @map("sort_order")

  company     Company          @relation(fields: [companyId], references: [id])
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])
  returnItems SaleReturnItem[]

  @@index([companyId, saleId])
  @@index([companyId, productId])
  @@map("sale_items")
}

model SalePayment {
  id             String         @id @default(uuid(7)) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  saleId         String         @map("sale_id") @db.Uuid
  method         PaymentMethod
  amount         Decimal        @db.Decimal(14, 2)
  /// cash given back; only CASH may have it
  change         Decimal        @default(0) @db.Decimal(14, 2)
  reference      String?
  providerStatus PaymentStatus? @map("provider_status")
  /// credit payments only: the unpaid amount waits for accounts receivable until this date
  dueDate        DateTime?      @map("due_date") @db.Date

  company Company @relation(fields: [companyId], references: [id])
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([companyId, saleId])
  @@map("sale_payments")
}

/// Minimal invoice record written by a completed sale in status PENDING; the SIAT epic (HU-FAC) issues it. `number` stays
/// null until then. The customer tax data is copied at sale time.
model Invoice {
  id                     String        @id @default(uuid(7)) @db.Uuid
  companyId              String        @map("company_id") @db.Uuid
  saleId                 String        @unique @map("sale_id") @db.Uuid
  number                 Int?
  status                 InvoiceStatus @default(PENDING)
  total                  Decimal       @db.Decimal(14, 2)
  customerTaxName        String        @map("customer_tax_name")
  customerDocumentType   Int           @map("customer_document_type")
  customerDocumentNumber String        @map("customer_document_number")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])
  sale    Sale    @relation(fields: [saleId], references: [id])

  @@index([companyId, status])
  @@map("invoices")
}

model Quote {
  id             String               @id @default(uuid(7)) @db.Uuid
  companyId      String               @map("company_id") @db.Uuid
  /// `COT-000012`
  number         String
  customerId     String               @map("customer_id") @db.Uuid
  status         QuoteStatus          @default(DRAFT)
  validUntil     DateTime             @map("valid_until") @db.Date
  subtotal       Decimal              @db.Decimal(14, 2)
  discountType   CustomerDiscountType @default(NONE) @map("discount_type")
  discountValue  Decimal              @default(0) @map("discount_value") @db.Decimal(14, 2)
  discountAmount Decimal              @default(0) @map("discount_amount") @db.Decimal(14, 2)
  roundingAmount Decimal              @default(0) @map("rounding_amount") @db.Decimal(14, 2)
  total          Decimal              @db.Decimal(14, 2)
  /// one entry per time the quote was sent (channel, date, user)
  sendLog        Json                 @default("[]") @map("send_log")
  createdById    String               @map("created_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company      @relation(fields: [companyId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  items       QuoteItem[]
  salesOrders SalesOrder[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([companyId, customerId])
  @@map("quotes")
}

model QuoteItem {
  id        String  @id @default(uuid(7)) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  quoteId   String  @map("quote_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)
  sortOrder Int     @default(0) @map("sort_order")

  company Company @relation(fields: [companyId], references: [id])
  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([companyId, quoteId])
  @@map("quote_items")
}

/// Reserves stock in `warehouseId` (`StockLevel.reserved`); a dispatch turns the reservation into a movement.
model SalesOrder {
  id          String           @id @default(uuid(7)) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  /// `PED-000012`
  number      String
  customerId  String           @map("customer_id") @db.Uuid
  quoteId     String?          @map("quote_id") @db.Uuid
  branchId    String           @map("branch_id") @db.Uuid
  warehouseId String           @map("warehouse_id") @db.Uuid
  status      SalesOrderStatus @default(OPEN)
  createdById String           @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company          @relation(fields: [companyId], references: [id])
  customer   Customer         @relation(fields: [customerId], references: [id])
  quote      Quote?           @relation(fields: [quoteId], references: [id])
  branch     Branch           @relation(fields: [branchId], references: [id])
  warehouse  Warehouse        @relation(fields: [warehouseId], references: [id])
  items      SalesOrderItem[]
  dispatches Dispatch[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([companyId, customerId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                 String  @id @default(uuid(7)) @db.Uuid
  companyId          String  @map("company_id") @db.Uuid
  orderId            String  @map("order_id") @db.Uuid
  productId          String  @map("product_id") @db.Uuid
  quantity           Int
  unitPrice          Decimal @map("unit_price") @db.Decimal(14, 2)
  reservedQuantity   Int     @default(0) @map("reserved_quantity")
  dispatchedQuantity Int     @default(0) @map("dispatched_quantity")

  company       Company        @relation(fields: [companyId], references: [id])
  order         SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  dispatchItems DispatchItem[]

  @@index([companyId, orderId])
  @@index([companyId, productId])
  @@map("sales_order_items")
}

model Dispatch {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  /// `DSP-000012`
  number      String
  /// the sale that invoiced this dispatch, once it is invoiced
  saleId      String?  @map("sale_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company        @relation(fields: [companyId], references: [id])
  order   SalesOrder     @relation(fields: [orderId], references: [id])
  sale    Sale?          @relation(fields: [saleId], references: [id])
  items   DispatchItem[]

  @@unique([companyId, number])
  @@index([companyId, orderId])
  @@map("dispatches")
}

model DispatchItem {
  id          String @id @default(uuid(7)) @db.Uuid
  companyId   String @map("company_id") @db.Uuid
  dispatchId  String @map("dispatch_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  quantity    Int

  company   Company        @relation(fields: [companyId], references: [id])
  dispatch  Dispatch       @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  orderItem SalesOrderItem @relation(fields: [orderItemId], references: [id])

  @@index([companyId, dispatchId])
  @@map("dispatch_items")
}

model SaleReturn {
  id                  String       @id @default(uuid(7)) @db.Uuid
  companyId           String       @map("company_id") @db.Uuid
  saleId              String       @map("sale_id") @db.Uuid
  /// `DEV-000012`
  number              String
  refundMethod        RefundMethod @map("refund_method")
  total               Decimal      @db.Decimal(14, 2)
  /// the credit note record, when the refund is a credit note (HU-FAC issues it)
  creditNoteInvoiceId String?      @map("credit_note_invoice_id") @db.Uuid
  createdById         String       @map("created_by_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company          @relation(fields: [companyId], references: [id])
  sale    Sale             @relation(fields: [saleId], references: [id])
  items   SaleReturnItem[]

  @@unique([companyId, number])
  @@index([companyId, saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id         String @id @default(uuid(7)) @db.Uuid
  companyId  String @map("company_id") @db.Uuid
  returnId   String @map("return_id") @db.Uuid
  saleItemId String @map("sale_item_id") @db.Uuid
  quantity   Int

  company  Company    @relation(fields: [companyId], references: [id])
  return   SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem   @relation(fields: [saleItemId], references: [id])

  @@index([companyId, returnId])
  @@map("sale_return_items")
}

/// Append-only audit of single and bulk price edits (`batchId` groups a bulk update).
model PriceChange {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  oldPrice  Decimal  @map("old_price") @db.Decimal(14, 2)
  newPrice  Decimal  @map("new_price") @db.Decimal(14, 2)
  userId    String   @map("user_id") @db.Uuid
  batchId   String?  @map("batch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([companyId, productId, createdAt(sort: Desc)])
  @@index([companyId, batchId])
  @@map("price_changes")
}

/// Generic approval inbox entry: the cancellation of a sale, a cash difference or a return. `subjectId` points at the
/// sale, shift or return, depending on `type`.
model ApprovalRequest {
  id            String         @id @default(uuid(7)) @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  type          ApprovalType
  subjectId     String         @map("subject_id") @db.Uuid
  status        ApprovalStatus @default(PENDING)
  requestedById String         @map("requested_by_id") @db.Uuid
  reason        String?
  decidedById   String?        @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(3)
  comment       String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status, type])
  @@index([companyId, type, subjectId])
  @@map("approval_requests")
}

/// Row-locked counter behind the document numbers (`V-`, `COT-`, `PED-`, `DSP-`, `DEV-`): see `nextDocumentNumber`.
model DocumentSequence {
  id        String @id @default(uuid(7)) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  key       String
  last      BigInt @default(0)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
  @@map("document_sequences")
}

// ── Cross-cutting ───────────────────────────────────────────────────────────

/// Audit log: who did what, on which entity, before and after.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  companyId String?  @map("company_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String // auth.login, sales.cancellation.approve…
  entity    String?
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// Transactional outbox: domain events are written in the SAME transaction as the
/// business change; the worker publishes them (accounting entries, SIAT, e-mails).
model OutboxEvent {
  id             BigInt    @id @default(autoincrement())
  companyId      String?   @map("company_id") @db.Uuid
  type           String // sale.completed, invoice.issue, auth.password-reset…
  payload        Json
  /// key to deduplicate consumers (e.g. invoice:<id>:issue)
  idempotencyKey String?   @unique @map("idempotency_key")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id])

  @@index([processedAt, availableAt])
  @@map("outbox_events")
}
