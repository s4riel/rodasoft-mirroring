{
  "name": "erp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "rs",
  "sourceRoot": "apps/erp/src",
  "tags": [
    "scope:frontend",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/erp",
        "browser": "apps/erp/src/main.ts",
        "tsConfig": "apps/erp/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/erp/public"
          }
        ],
        "styles": [
          "apps/erp/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "libs/ui/src/styles"
          ]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "12kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/erp/src/environments/environment.ts",
              "with": "apps/erp/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4200,
        "proxyConfig": "apps/erp/proxy.conf.json",
        "allowedHosts": [
          "rodalaser.localhost",
          "empresa2.localhost",
          "localhost"
        ]
      },
      "configurations": {
        "production": {
          "buildTarget": "erp:build:production"
        },
        "development": {
          "buildTarget": "erp:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/erp/jest.config.ts"
      }
    }
  }
}