# ── General ───────────────────────────────────────────────
NODE_ENV=development
APP_TZ=America/La_Paz

# ── API ───────────────────────────────────────────────────
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
# Orígenes permitidos (CORS), separados por coma. *.localhost resuelve a 127.0.0.1 en Chrome/Edge/Firefox.
CORS_ORIGINS=http://rodalaser.localhost:4200,http://company2.localhost:4200,http://localhost:4200,http://localhost:4300

# ── Base de datos y colas ─────────────────────────────────
DATABASE_URL=postgresql://rodasoft:rodasoft@localhost:5432/rodasoft?schema=public
REDIS_URL=redis://localhost:6379

# ── Autenticación ─────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Google OAuth (console.cloud.google.com → Credenciales → ID de cliente OAuth "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Si solo se permiten cuentas de un dominio de Google Workspace, ponerlo aquí (vacío = cualquier cuenta invitada)
GOOGLE_ALLOWED_HD=
# A dónde vuelve el navegador después de Google (el ERP agrega la empresa)
ERP_PUBLIC_URL=http://{company}.localhost:4200

# ── Cifrado de secretos en BD (credenciales SIAT, .p12) ───
# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=

# ── Correo ────────────────────────────────────────────────
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Rodalaser ERP <no-reply@rodalaser.com.bo>"

# ── SIAT (solo para el spike: tools/siat-spike) ───────────
SIAT_ENVIRONMENT=2
SIAT_BASE_URL=https://pilotosiatservicios.impuestos.gob.bo/v2
SIAT_TOKEN=
SIAT_NIT=
SIAT_SYSTEM_CODE=
SIAT_BRANCH_CODE=0
SIAT_POINT_OF_SALE_CODE=0
SIAT_MODALITY=1
SIAT_P12_PATH=./secrets/firma.p12
SIAT_P12_PASSWORD=

# Uploads (product photos and datasheets). `local` writes to STORAGE_LOCAL_DIR; `s3` uses any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
