{
  "name": "rodasoft",
  "version": "0.1.0",
  "private": true,
  "description": "Rodalaser S.R.L. — ERP multiempresa, facturación SIAT, tienda en línea y sitio web",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:infra": "docker compose up -d",
    "dev:api": "nx serve api",
    "dev:worker": "nx serve worker",
    "dev:erp": "nx serve erp",
    "dev:web": "nx serve web",
    "dev": "nx run-many -t serve -p api worker erp --parallel=3",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "affected": "nx affected -t lint test build",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "tsx --tsconfig tsconfig.base.json --env-file=.env apps/api/prisma/seed.ts",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "api:client": "nx run api-client:generate",
    "siat:spike": "tsx --tsconfig tsconfig.base.json --env-file=.env tools/siat-spike/spike.ts",
    "format": "prettier --write .",
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma"
  },
  "dependencies": {
    "@angular/animations": "~20.3.0",
    "@angular/cdk": "~20.2.0",
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/platform-server": "~20.3.0",
    "@angular/router": "~20.3.0",
    "@angular/ssr": "~20.3.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@ngrx/signals": "^20.0.0",
    "@prisma/client": "^6.16.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "nestjs-cls": "^6.0.1",
    "nestjs-pino": "^4.4.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^7.0.6",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "soap": "^1.3.0",
    "tslib": "^2.8.1",
    "xml-crypto": "^6.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~20.3.0",
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@angular/language-service": "~20.3.0",
    "@eslint/js": "^9.35.0",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@nx/angular": "~21.6.0",
    "@nx/eslint": "~21.6.0",
    "@nx/eslint-plugin": "~21.6.0",
    "@nx/jest": "~21.6.0",
    "@nx/js": "~21.6.0",
    "@nx/nest": "~21.6.0",
    "@nx/node": "~21.6.0",
    "@nx/webpack": "~21.6.0",
    "@nx/workspace": "~21.6.0",
    "@playwright/test": "^1.64.1",
    "@swc-node/register": "~1.10.10",
    "@swc/core": "~1.13.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": ">=6.4.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "angular-eslint": "^20.3.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "~14.6.1",
    "nx": "~21.6.0",
    "openapi-typescript": "^7.9.1",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "prisma": "^6.16.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0",
    "webpack-cli": "^5.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "nx"
    ]
  }
}